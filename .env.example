# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never expose it in the browser or commit it to GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin access ----
# Comma-separated emails allowed into /admin. Each must also exist as a user in
# Supabase -> Authentication -> Users.
ADMIN_EMAILS=you@example.com

# ---- Site ----
SITE_URL=https://www.edgelifetransportation.com

# ---- Email alerts for new bookings and applications (optional) ----
# Hostinger mailbox example: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@edgelifetransport.com
SMTP_PASS=
NOTIFY_TO=info@edgelifetransport.com
